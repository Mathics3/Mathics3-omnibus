#!/usr/bin/env bash
set -e
if [ -n "$DEBUG" ]; then
    set -x
fi

# The release name we are configured to run under.
typeset dmathics_version='1.0.0'

# Allow customization using POSIX environment variables:
DOCKER=${DOCKER:-docker}

TAG=${TAG:-latest}
MATHICS3_IMAGE=${MATHICS3_IMAGE:-mathicsorg/mathics3:${TAG}}

for arg in "$@" ; do
    case "$arg" in
        -h | --help | help )
			cat <<_EOH
usage:
   dmathics3 [options]

  A stripped-down command-line interface to Mathics3 run in a docker container

Options specfic to dmathicsdoc:

  -u | -U | --upgrade | upgrade
  pull updates to the docker container if there is a new image

  -h| --help | help
  show this help and exit

  -V| --version
  show the dmathicsdoc version and exit

_EOH
			stripped_args+=("--help")
			;;
        -u | -U | --upgrade | upgrade)
			$DOCKER pull $MATHICS3_IMAGE
			;;
        -v | -V | --version)
			echo "dmathicsdoc version ${dmathicsdoc_version}"
			exit 100
			;;
		default)
			stripped_args+=($arg)
    esac
done

# Show environment variables
for env_setting in MATHICS3_IMAGE; do
	echo $env_setting = ${!env_setting}
done


$DOCKER run \
	--rm \
	-it \
	--env "COLORFGBG=$COLORFGBG" \
	--name mathics-cli \
	--volume /tmp:/usr/src/app/data \
	$MATHICS3_IMAGE \
	--mode mathics -- $@
